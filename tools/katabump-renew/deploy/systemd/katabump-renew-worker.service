[Unit]
Description=Katabump renew request worker
After=network-online.target qinglong-d3.service woiden-browser.service
Wants=network-online.target woiden-browser.service

[Service]
Type=simple
User=root
Group=root
ExecStart=/opt/woiden-renew/venv/bin/python /opt/katabump-renew/katabump_worker.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths=/opt/katabump-renew /opt/qinglong/data/config/katabump-renew /home/ubuntu/.cache /home/ubuntu/.config

[Install]
WantedBy=multi-user.target
