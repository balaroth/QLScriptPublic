#!/usr/bin/env sh
# qlrun - 单脚本手动执行包装器：全局串行、业务失败最多重试3次、仅最终失败发送一封邮件。
# 子脚本每次尝试均注入 QL_SUPPRESS_NOTIFY=1；通知所有权由本层独占。

FILE="$1"
[ -z "$FILE" ] && { echo "qlrun: missing file"; exit 1; }

DATA="${QL_DATA_DIR:-/ql/data}"
LOCKD="$DATA/.qlrun"
LOCKDIR="$LOCKD/global.lock.d"
QUEUELOG="$LOCKD/queue.log"
MAX_WAIT=7200
ATTEMPTS=3
RETRY_GAP=20
RUN_TIMEOUT=600
mkdir -p "$LOCKD" 2>/dev/null

TS() { date '+%Y-%m-%d %H:%M:%S'; }
logq() { echo "[$(TS)] $*" >> "$QUEUELOG"; }

NAME=$(basename "$FILE")
PARENT_SUPPRESS="${QL_SUPPRESS_NOTIFY:-}"
logq "ENQUEUE file=$FILE pid=$$"
echo "[$(TS)] [qlrun] 排队请求：$NAME"

WAITED=0
ACQUIRED=0
i=0
while [ $i -lt 1440 ]; do
    if mkdir "$LOCKDIR" 2>/dev/null; then
        echo $$ > "$LOCKDIR/pid" 2>/dev/null
        ACQUIRED=1
        break
    fi
    OPID=$(cat "$LOCKDIR/pid" 2>/dev/null)
    if [ -n "$OPID" ] && ! kill -0 "$OPID" 2>/dev/null; then
        rm -rf "$LOCKDIR" 2>/dev/null
        continue
    fi
    sleep 5
    WAITED=$((WAITED+5))
    [ $WAITED -ge $MAX_WAIT ] && break
    i=$((i+1))
done

if [ $ACQUIRED -ne 1 ]; then
    echo "[$(TS)] [qlrun] 排队超过 ${MAX_WAIT}s，放弃：$NAME"
    logq "GIVEUP file=$FILE pid=$$ waited=${WAITED}s"
    exit 124
fi
logq "ACQUIRE file=$FILE pid=$$ waited=${WAITED}s"
echo "[$(TS)] [qlrun] 获得执行槽（等待 ${WAITED}s）：$NAME"
release() { rm -rf "$LOCKDIR" 2>/dev/null; logq "RELEASE file=$FILE pid=$$"; }
trap release EXIT INT TERM

# 返回值：0=业务失败，1=业务成功，2=无法判定。
# 新脚本优先输出结构化 [QLRUN_RESULT]；旧脚本继续使用保守的失败信号优先策略。
is_business_fail() {
    L="$1"
    grep -avE 'spawnSync|node:internal|sitecustomize|/bin/bash|ENOENT|execSync|SMTP|发送通知|run task before error|wxbridge|Center 通知|系统通知' "$L" 2>/dev/null > "$L.clean"
    if grep -aqE '\[QLRUN_RESULT\][[:space:]]+FAILURE([[:space:]]|$)' "$L.clean"; then
        return 0
    fi
    if grep -aqE '\[QLRUN_RESULT\][[:space:]]+SUCCESS([[:space:]]|$)' "$L.clean"; then
        return 1
    fi
    if grep -aqE 'MODULE_NOT_FOUND|Cannot find module|取不到|失效|实人|人机验证|安全验证|拦截|滑块|风控|断开|无响应|未完成|未配置|未拿到|未返回 code|未开就|无法|缺少|错误|超时|未查询|NO_TOKEN|NO_MOBILE|denied|expired|40001|40029|404001|⚠|❌|执行失败|登录失败|签到失败|请求失败|未登录|会话失效|登录失效|invalid session|SESSION_INVALID|Bad Auth|信息获取失败|未找到变量|未填写变量|选择账号|choose_account|运行失败' "$L.clean"; then
        return 0
    fi
    if grep -aqE '✅|签到成功|签到：?成功|今日已签|已签到|已经签到|今日已完成|登录成功|领取成功|执行完成|任务执行完成' "$L.clean"; then
        return 1
    fi
    return 2
}

sanitize_reason() {
    L="$1"
    grep -aE 'MODULE_NOT_FOUND|Cannot find module|取不到|失效|实人|人机验证|安全验证|拦截|滑块|风控|断开|无响应|未完成|未配置|未拿到|未返回 code|未开就|无法|缺少|错误|超时|未查询|NO_TOKEN|NO_MOBILE|denied|expired|40001|40029|404001|⚠|❌|执行失败|登录失败|签到失败|请求失败|未登录|会话失效|登录失效|invalid session|SESSION_INVALID|Bad Auth|信息获取失败|未找到变量|未填写变量|选择账号|choose_account|运行失败' "$L" 2>/dev/null \
      | tail -n 8 \
      | sed -E 's/(jwtToken|token|passToken|session|cookie|openid|unionid|key|mobile|phone)[=: ]+[^ ,;]+/\1=***REDACTED***/Ig; s/[0-9]{11}/***PHONE***/g' \
      | cut -c1-500
}

send_final_notice() {
    STATUS="$1"
    REASON="$2"
    if [ "$PARENT_SUPPRESS" = "1" ] || [ "$PARENT_SUPPRESS" = "true" ]; then
        echo "[$(TS)] [qlrun] 上层批量任务持有通知所有权，本层跳过单发"
        return 0
    fi
    TITLE="【qlrun】${NAME} ${STATUS}"
    BODY="脚本：${FILE}\n结果：${STATUS}\n执行次数：${ATT}/${ATTEMPTS}\n退出码：${RC}"
    [ -n "$REASON" ] && BODY="$BODY\n关键原因：\n$REASON"
    NODE_BIN=$(command -v node 2>/dev/null || true)
    [ -z "$NODE_BIN" ] && NODE_BIN="/usr/bin/node"
    QLRUN_TITLE="$TITLE" QLRUN_BODY="$BODY" QL_SUPPRESS_NOTIFY= \
      "$NODE_BIN" -e '
        const path=require("path");
        const data=process.env.QL_DATA_DIR || "/ql/data";
        const repo=path.join(data,"scripts","smallfawn_QLScriptPublic");
        const {sendNotify}=require(path.join(repo,"tools","sendNotify.js"));
        Promise.resolve(sendNotify(process.env.QLRUN_TITLE, process.env.QLRUN_BODY, {}))
          .then(()=>process.exit(0)).catch(e=>{console.log("[qlrun] 最终通知失败: "+(e&&e.message?e.message:String(e)));process.exit(0)});
      ' || true
}

OUTD="$LOCKD/out"; mkdir -p "$OUTD" 2>/dev/null
ATT=0
FINAL=1
RC=1
FINAL_REASON=""
while [ $ATT -lt $ATTEMPTS ]; do
    ATT=$((ATT+1))
    OUT="$OUTD/${NAME}.$$.$ATT.log"
    echo "[$(TS)] [qlrun] ===== 第 ${ATT}/${ATTEMPTS} 次执行：$NAME ====="

    (
      # 青龙定时任务会注入这些日志重定向变量；若传给子 task，子日志不会回到 OUT，
      # qlrun 将看不到 [QLRUN_RESULT] 并把成功误判为失败。
      unset no_tee real_log_path log_name real_time
      export QL_SUPPRESS_NOTIFY=1 ONLY_ERROR_NOTIFY=true
      timeout --foreground -s 2 -k 15s $RUN_TIMEOUT /ql/shell/task.sh "$FILE"
    ) > "$OUT" 2>&1
    RC=$?
    cat "$OUT"

    FAIL=1
    NO_RETRY=0
    if grep -aqE '\[QLRUN_RESULT\][[:space:]]+FAILURE.*retryable=0([[:space:]]|$)' "$OUT"; then
        NO_RETRY=1
    fi
    if [ $RC -eq 0 ]; then
        is_business_fail "$OUT"
        VERDICT=$?
        if [ $VERDICT -eq 1 ]; then
            FAIL=0
        elif [ $VERDICT -eq 2 ]; then
            echo "[$(TS)] [qlrun] 第 ${ATT} 次无明确业务成功证据，按失败处理"
        fi
    elif [ $RC -eq 124 ] || [ $RC -eq 137 ]; then
        echo "[$(TS)] [qlrun] 第 ${ATT} 次超时/被杀(rc=$RC)"
    else
        echo "[$(TS)] [qlrun] 第 ${ATT} 次进程非零退出(rc=$RC)"
    fi

    FINAL_REASON=$(sanitize_reason "$OUT")
    rm -f "$OUT" "$OUT.clean" 2>/dev/null

    if [ $FAIL -eq 0 ]; then
        echo "[$(TS)] [qlrun] 第 ${ATT} 次业务执行成功 ✅"
        FINAL=0
        break
    fi
    FINAL=1
    if [ $NO_RETRY -eq 1 ]; then
        echo "[$(TS)] [qlrun] 结构化结果标记 retryable=0，确定性失败不再重试"
        break
    fi
    if [ $ATT -lt $ATTEMPTS ]; then
        echo "[$(TS)] [qlrun] 第 ${ATT} 次业务失败，${RETRY_GAP}s 后重试…"
        sleep $RETRY_GAP
    else
        echo "[$(TS)] [qlrun] 已执行 ${ATTEMPTS} 次仍业务失败，由 qlrun 发送一封最终失败通知。"
    fi
done

if [ $FINAL -ne 0 ]; then
    send_final_notice "业务失败" "$FINAL_REASON"
else
    echo "[$(TS)] [qlrun] 业务成功，按失败专报策略不发送邮件"
fi
logq "DONE file=$FILE pid=$$ fail=$FINAL"
exit $FINAL
