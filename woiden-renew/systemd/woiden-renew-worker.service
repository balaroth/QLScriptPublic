[Unit]
Description=Woiden renew request worker
After=network-online.target qinglong-d3.service
Wants=network-online.target
[Service]
Type=simple
User=root
Group=root
ExecStart=/opt/woiden-renew/venv/bin/python /opt/woiden-renew/woiden_worker.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths=/opt/woiden-renew /opt/qinglong/data/config/woiden-renew /home/ubuntu/.cache /home/ubuntu/.config
[Install]
WantedBy=multi-user.target
